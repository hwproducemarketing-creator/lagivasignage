# Local development
PORT=4000
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=100
NODE_ENV=development

# --- Railway production ---
# NODE_ENV=production
# PORT is set automatically by Railway
# DATA_DIR=/data
# SESSION_SECRET=<long-random-string>
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=<strong-password>
# CORS_ORIGIN=https://heroic-acceptance-production-433e.up.railway.app
# MAX_UPLOAD_MB=100
# Attach a Railway Volume mounted at /data (persists SQLite + uploads)

# --- Raspberry Pi local / hotspot (see pi/README.md) ---
# NODE_ENV=production
# PORT=4000
# DATA_DIR=/home/pi/hw-signage-data
# COOKIE_SECURE=false
# SESSION_SECRET=<long-random-string>
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=<strong-password>
# CORS_ORIGIN=http://127.0.0.1:4000,http://localhost:4000,http://10.42.0.1:4000,http://192.168.4.1:4000
