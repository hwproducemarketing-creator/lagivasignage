[Unit]
Description=H&W Produce Digital Signage server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SIGNAGE_USER__
Group=__SIGNAGE_USER__
WorkingDirectory=__INSTALL_DIR__
Environment=NODE_ENV=production
EnvironmentFile=__INSTALL_DIR__/.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
# Large uploads over slow store Wi‑Fi / hotspot
TimeoutStartSec=60
TimeoutStopSec=30

# Nice for kiosk Pi — keep UI responsive
Nice=5

[Install]
WantedBy=multi-user.target
