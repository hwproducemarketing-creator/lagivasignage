# H&W Signage — Raspberry Pi local / hotspot
# Copied to repo root as .env by setup.sh (edit passwords after install)

NODE_ENV=production
PORT=4000
DATA_DIR=/home/pi/hw-signage-data

# HTTP on the hotspot — required so admin login cookies work
COOKIE_SECURE=false

SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Hotspot gateway IPs (NetworkManager → 10.42.0.1, hostapd fallback → 192.168.4.1)
CORS_ORIGIN=http://127.0.0.1:4000,http://localhost:4000,http://10.42.0.1:4000,http://192.168.4.1:4000

MAX_UPLOAD_MB=100
